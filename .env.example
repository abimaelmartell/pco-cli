# Create a Planning Center personal access token or OAuth app credentials,
# then set either a bearer token or a client id/secret pair.
#
# Personal access tokens are labeled Client ID + Secret. PCO_APP_ID is a
# compatible alias of PCO_CLIENT_ID.
#
# You can also copy this file to ~/.config/pco/env (or $XDG_CONFIG_HOME/pco/env)
# so the CLI reads credentials without a project .env or flags on every command.
PCO_ACCESS_TOKEN=
PCO_CLIENT_ID=
PCO_SECRET=
# PCO_APP_ID=
PCO_BASE_URL=https://api.planningcenteronline.com
PCO_USER_AGENT=pco-cli/0.1.1
